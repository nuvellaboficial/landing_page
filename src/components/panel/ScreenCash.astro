---
import { CASH, CASH_ROWS } from '../../lib/data';
import { formatCop } from '../../lib/util';
---

<div class="screen screen--cash">
  <div class="dash__row cash__head">
    <div>
      <div class="dash__title">Cierre de Caja Diaria</div>
      <div class="cash__sub">Ingresos y egresos del negocio, día por día.</div>
    </div>
    <div class="cash__actions">
      <span class="dash-btn">+ Ingreso</span><span class="dash-btn">+ Egreso</span><span class="dash-btn">Cerrar el día</span>
    </div>
  </div>
  <div class="cash__totals">
    <div class="dash-card cash__total">
      <div class="dash-label">Ingresos</div>
      <div class="cash__amount cash__amount--in">$ <span data-cash-income>{formatCop(CASH.incomeAfter)}</span></div>
    </div>
    <div class="dash-card cash__total">
      <div class="dash-label">Egresos</div>
      <div class="cash__amount cash__amount--out">$ {formatCop(CASH.expenses)}</div>
    </div>
    <div class="dash-card cash__total">
      <div class="dash-label">Neto</div>
      <div class="cash__amount">$ <span data-cash-net>{formatCop(CASH.incomeAfter - CASH.expenses)}</span></div>
    </div>
  </div>
  <div class="cash__table">
    <div class="cash__tr cash__th dash-label"><span>Hora</span><span>Movimiento</span><span>Cliente / categoría</span><span class="cash__r">Monto</span></div>
    <div class="cash__tr cash__new" data-cash-new>
      <span class="muted">3:12 p. m.</span><span>Abono de cita</span><span>Laura Restrepo<br /><span class="muted">Masaje relajante</span></span><span class="cash__r cash__amount--in">+$ 30.000</span>
    </div>
    {
      CASH_ROWS.map(([h, m, c, k, v, income]) => (
        <div class="cash__tr">
          <span class="muted">{h}</span>
          <span>{m}</span>
          <span>
            {c}
            <br />
            <span class="muted">{k}</span>
          </span>
          <span class:list={['cash__r', income ? 'cash__amount--in' : 'cash__amount--out']}>{v}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .screen--cash {
    padding: 18px 20px;
  }
  .cash__head {
    align-items: flex-end;
  }
  .cash__sub {
    font: 12px var(--font-body);
    color: var(--muted);
    margin-top: 6px;
  }
  .cash__actions {
    display: flex;
    gap: 6px;
  }
  .cash__actions .dash-btn {
    font-size: 10.5px;
    padding: 7px 9px;
  }
  .cash__totals {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .cash__total {
    border-radius: 10px;
    padding: 12px;
  }
  .cash__amount {
    font: 600 17px var(--font-body);
    margin-top: 4px;
  }
  .cash__amount--in {
    color: var(--income);
  }
  .cash__amount--out {
    color: var(--expense);
  }
  .cash__table {
    flex: 1;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #101010;
    overflow: hidden;
    font: 11px/1.3 var(--font-body);
  }
  .cash__tr {
    display: grid;
    grid-template-columns: 80px 1.2fr 1.6fr 100px;
    padding: 9px 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .cash__th {
    border-top: none;
    background: var(--surface-2);
    font-size: 9px;
  }
  .cash__r {
    text-align: right;
  }
  .cash__tr.cash__new {
    background: rgba(255, 153, 51, 0.08);
  }
</style>
