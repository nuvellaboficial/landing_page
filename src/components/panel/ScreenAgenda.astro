---
import { NICHES } from '../../lib/data';
import { agendaHtml, agendaLayout } from '../../lib/templates';

// An appointment being dragged to another worker's column (styles are global:
// the markup is injected through set:html, outside Astro's scoping).
const dragged = `<div class="agenda-drag"><div class="cal__name">Mariana Ríos</div><div class="muted">Facial hidratante</div><span class="agenda-drag__cursor"></span></div>`;
---

<div class="screen screen--agenda">
  <div class="dash__row">
    <div class="dash__title">Citas</div>
    <div class="dash-btn dash-btn--primary">+ Nueva cita</div>
  </div>
  <div class="dash-toolbar">
    <div class="seg"><span class="is-on">Día</span><span>Semana</span></div>
    <span>Hoy <span class="muted">Jueves, 24 de septiembre</span></span>
    <span class="agenda__spacer"></span>
    <div class="seg"><span>Lista</span><span class="is-on">Calendario</span></div>
  </div>
  <div class="agenda__wrap" set:html={agendaHtml(agendaLayout(NICHES[0]), { showTimes: true, areaExtra: dragged })} />
</div>

<style>
  .screen--agenda {
    padding: 16px 20px;
  }
  .agenda__spacer {
    flex: 1;
  }
  .agenda__wrap {
    flex: 1;
    display: flex;
    min-height: 0;
  }
  :global(.agenda-drag) {
    position: absolute;
    left: 4px;
    top: 8px;
    width: 195px;
    height: 56px;
    box-sizing: border-box;
    border-radius: 6px;
    padding: 5px 7px;
    font: 10px/1.35 var(--font-body);
    background: #232323;
    border: 1px dashed rgba(255, 255, 255, 0.35);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.5);
    animation: agenda-drag 5s var(--ease-in-out) infinite;
  }
  :global(.agenda-drag__cursor) {
    position: absolute;
    right: 18px;
    bottom: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--fg);
    border: 2px solid var(--bg);
  }
  @keyframes agenda-drag {
    0%,
    18% {
      transform: translate(0, 0);
    }
    42%,
    78% {
      transform: translate(203px, 60px);
    }
    100% {
      transform: translate(0, 0);
    }
  }
</style>
