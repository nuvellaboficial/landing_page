---
import { CASH, TODAY } from '../../lib/data';
import { formatCop } from '../../lib/util';
---

<!-- First screen of "Tu panel": active by default. -->
<div class="screen screen--home is-active">
  <div class="dash__row home__head">
    <div>
      <div class="dash__title">Hola, Sebastián</div>
      <div class="home__date">Jueves, 24 de septiembre</div>
    </div>
    <div class="dash-btn dash-btn--primary">+ Nueva cita</div>
  </div>
  <div class="home__grid">
    <div class="dash-card home__cash">
      <div class="home__cash-top">
        <div class="home__col">
          <div class="dash-label">Caja hoy</div>
          <div class="home__big">$ <span data-cash-today>{formatCop(CASH.todayNet)}</span></div>
          <div class="home__legend">
            <span class="dot dot--in">●</span> $ {formatCop(CASH.incomeAfter)} ingresos<br />
            <span class="dot dot--out">●</span> $ {formatCop(CASH.expenses)} egresos
          </div>
        </div>
        <div class="home__col home__col--split">
          <div class="dash-label">Ingreso esperado hoy</div>
          <div class="home__mid">$ 360.000</div>
          <div class="home__note">Lo que entra a caja si se atienden las 3 citas de hoy</div>
        </div>
      </div>
      <div class="home__chart">
        <div class="dash-label">Neto de caja · últimos 14 días</div>
        <svg viewBox="0 0 400 110" preserveAspectRatio="none">
          <polyline
            points="0,40 31,95 62,92 92,86 123,94 154,86 185,82 215,94 246,76 277,94 308,58 338,68 369,88 400,8"
            fill="none"
            stroke="#ff9933"
            stroke-width="2"
            vector-effect="non-scaling-stroke"></polyline>
        </svg>
        <div class="home__axis"><span>11 sep</span><span>Hoy</span></div>
      </div>
    </div>
    <div class="home__side">
      <div class="dash-card home__small">
        <div class="dash-label">Mañana</div>
        <div class="home__count">4 <span>citas</span></div>
        <div class="home__legend">
          <span class="dot">●</span> Primera 8:30 a. m.<br /><span class="dot">●</span> 4 por confirmar
        </div>
      </div>
      <div class="dash-card home__small home__today">
        <div class="dash-label">Hoy · 3 citas</div>
        {
          TODAY.map(([name, svc, time]) => (
            <div class="home__row">
              <div>
                <div class="home__name">{name}</div>
                <div class="muted">{svc}</div>
              </div>
              <div class="muted">{time}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .screen--home {
    padding: 18px 20px;
  }
  .home__head {
    align-items: flex-start;
  }
  .home__date {
    font: 12px var(--font-body);
    color: var(--muted);
    margin-top: 6px;
  }
  .home__grid {
    display: flex;
    gap: 12px;
    flex: 1;
    min-height: 0;
  }
  .home__cash {
    flex: 2.1;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .home__cash-top {
    display: flex;
    gap: 18px;
  }
  .home__col {
    flex: 1;
  }
  .home__col--split {
    border-left: 1px solid var(--line);
    padding-left: 16px;
  }
  .home__big {
    font: 600 34px/1.1 var(--font-display);
    letter-spacing: -0.03em;
    margin-top: 4px;
  }
  .home__mid {
    font: 600 24px/1.2 var(--font-display);
    margin-top: 4px;
  }
  .home__note {
    font: 10.5px/1.4 var(--font-body);
    color: var(--muted);
    margin-top: 4px;
  }
  .home__legend {
    font: 11px/1.8 var(--font-body);
    color: #ccc;
    margin-top: 6px;
  }
  .dot {
    color: var(--accent);
  }
  .dot--in {
    color: var(--income);
  }
  .dot--out {
    color: var(--expense);
  }
  .home__chart {
    border-top: 1px solid var(--line);
    padding-top: 10px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .home__chart svg {
    flex: 1;
    width: 100%;
    margin-top: 8px;
  }
  .home__axis {
    display: flex;
    justify-content: space-between;
    font: 10px var(--font-body);
    color: var(--faint);
  }
  .home__side {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .home__small {
    padding: 14px;
  }
  .home__count {
    font: 600 28px/1.1 var(--font-display);
  }
  .home__count span {
    font: 400 12px var(--font-body);
    color: var(--muted);
  }
  .home__today {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .home__row {
    display: flex;
    justify-content: space-between;
    font: 11px/1.3 var(--font-body);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 7px;
  }
  .home__name {
    font-weight: 600;
  }
</style>
