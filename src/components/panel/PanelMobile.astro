---
/** Mobile version of "Tu panel": the dashboard's mobile layout inside a phone. */
import { CASH, CASH_ROWS, CLIENTS, PANEL_MOBILE_TITLES, TODAY } from '../../lib/data';
import { formatCop } from '../../lib/util';
import PhoneFrame from '../frames/PhoneFrame.astro';
---

<PhoneFrame scale=".9" screenClass="mdash" data-focus="panel">
  <div class="mdash__bar"><span aria-hidden="true">☰</span><span class="dash__user mdash__user">S</span></div>
  <div class="mdash__content">
    <div class="mdash__title" data-mobile-title>{PANEL_MOBILE_TITLES[0]}</div>

    <div class="mscreen" data-mscreen="0">
      <div class="mcard">
        <div class="dash-label">Caja hoy</div>
        <div class="mdash__big">$ <span data-cash-today>{formatCop(CASH.todayNet)}</span></div>
        <div class="mdash__legend"><span class="in">●</span> $ {formatCop(CASH.incomeAfter)} ingresos</div>
      </div>
      {
        TODAY.map(([name, svc, time]) => (
          <div class="mcard mcard--row">
            <div>
              <b>{name}</b>
              <div class="muted">{svc}</div>
            </div>
            <span class="muted">{time}</span>
          </div>
        ))
      }
    </div>

    <div class="mscreen" data-mscreen="1" hidden>
      <div class="mcard mcard--flush">
        <div class="mcard__acc"><b>Camila Ortiz</b><span class="muted">3 citas ⌃</span></div>
        <div class="mcard__list">
          <div class="mappt"><b>Mariana Ríos</b><div class="muted">Facial hidratante · 1:00 p. m.</div></div>
          <div class="mappt mappt--new"><b>Laura Restrepo</b><div>Masaje relajante · 3:00 p. m.</div></div>
          <div class="mappt"><b>Isabel Duque</b><div class="muted">Masaje relajante · 4:30 p. m.</div></div>
        </div>
      </div>
      <div class="mcard mcard--row"><b>Sara Londoño</b><span class="muted">2 citas ⌄</span></div>
      <div class="mcard mcard--row"><b>Paula Vélez</b><span class="muted">1 cita ⌄</span></div>
    </div>

    <div class="mscreen" data-mscreen="2" hidden>
      <div class="mdash__pair">
        <div class="mcard"><div class="dash-label">Ingresos</div><b class="in">$ <span data-cash-income>{formatCop(CASH.incomeAfter)}</span></b></div>
        <div class="mcard"><div class="dash-label">Neto</div><b>$ <span data-cash-net>{formatCop(CASH.incomeAfter - CASH.expenses)}</span></b></div>
      </div>
      <div class="mcard mcard--row mcard--new cash__new" data-cash-new>
        <div>Abono de cita<div class="muted">Laura Restrepo</div></div><span class="in">+$ 30.000</span>
      </div>
      {
        CASH_ROWS.slice(0, 4).map(([, m, c, , v, income]) => (
          <div class="mrow">
            <div>
              {m}
              <div class="muted">{c}</div>
            </div>
            <span class={income ? 'in' : 'out'}>{v}</span>
          </div>
        ))
      }
    </div>

    <div class="mscreen is-approved" data-mscreen="3" data-deposit hidden>
      <div class="mdash__receipt">comprobante de transferencia</div>
      <b class="mdash__who">Laura Restrepo · $ 30.000</b>
      <div class="muted">Masaje relajante · Viernes 25, 3:00 p. m.</div>
      <div class="deposit__approve mdash__approve">
        <span class="when-pending">Aprobar anticipo</span><span class="when-approved">Aprobado ✓</span>
      </div>
    </div>

    <div class="mscreen" data-mscreen="4" hidden>
      {
        CLIENTS.map(([name, phone, count]) => (
          <div class="mcard mcard--row">
            <div>
              <b>{name}</b>
              <div class="muted">{phone}</div>
            </div>
            <span class="muted">{count} citas</span>
          </div>
        ))
      }
    </div>
  </div>
</PhoneFrame>

<style>
  :global(.mdash) {
    background: var(--bg);
  }
  .mdash__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    font: 600 12px var(--font-body);
  }
  .mdash__user {
    width: 20px;
    height: 20px;
    line-height: 20px;
  }
  .mdash__content {
    flex: 1;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font: 11px/1.35 var(--font-body);
    overflow: hidden;
  }
  .mdash__title {
    font: 600 19px/1.1 var(--font-display);
    letter-spacing: -0.02em;
  }
  .mscreen {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mscreen[hidden] {
    display: none;
  }
  .mcard {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface-2);
    padding: 10px;
  }
  .mcard--row {
    display: flex;
    justify-content: space-between;
  }
  .mcard--flush {
    padding: 0;
    overflow: hidden;
    border-radius: 12px;
  }
  .mcard__acc {
    display: flex;
    justify-content: space-between;
    padding: 10px 12px;
  }
  .mcard__list {
    padding: 0 10px 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .mappt {
    background: var(--surface-3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 8px;
  }
  .mappt--new {
    background: var(--accent-soft);
    border-color: var(--accent);
  }
  .mdash__big {
    font: 600 26px/1.2 var(--font-display);
  }
  .mdash__legend {
    color: #ccc;
  }
  .mdash__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .mcard--new {
    border-color: var(--accent);
    background: #1a140e;
  }
  .mrow {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 8px 2px;
    display: flex;
    justify-content: space-between;
  }
  .in {
    color: var(--income);
  }
  .out {
    color: var(--expense);
  }
  .mdash__receipt {
    height: 150px;
    border-radius: 10px;
    background: repeating-linear-gradient(135deg, #171717 0 8px, #1c1c1c 8px 16px);
    display: grid;
    place-items: center;
    font: 10px var(--font-mono);
    color: var(--muted);
  }
  .mdash__who {
    font-size: 13px;
  }
  .mdash__approve {
    margin-top: 6px;
    text-align: center;
    border-radius: 8px;
    padding: 10px;
    font-weight: 600;
  }
</style>
