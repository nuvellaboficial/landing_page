---
/**
 * Laptop screen frame (no keyboard base) whose screen is an 880×550 canvas
 * scaled to the frame width. `width` and `scale` are CSS values; scale must
 * equal (width - 18px) / 880.
 */
interface Props {
  width: string;
  scale: string;
  class?: string;
  [key: `data-${string}`]: string;
}

const { width, scale, class: className, ...rest } = Astro.props;
---

<div class:list={['laptop', className]} style={`--w:${width};--screen-scale:${scale}`} {...rest}>
  <div class="laptop__lid">
    <div class="laptop__screen">
      <div class="laptop__canvas">
        <slot />
      </div>
    </div>
  </div>
</div>
