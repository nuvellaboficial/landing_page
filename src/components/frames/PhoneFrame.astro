---
/** Phone device frame. `scale` is any CSS value (e.g. "var(--k2)" or ".9"). */
interface Props {
  scale?: string;
  class?: string;
  screenClass?: string;
  [key: `data-${string}`]: string;
}

const { scale = '1', class: className, screenClass, ...rest } = Astro.props;
---

<div class:list={['phone', className]} style={`--k:${scale}`} {...rest}>
  <div class="phone__device" data-phone-device>
    <div class:list={['phone__screen', screenClass]}>
      <slot />
    </div>
  </div>
</div>
